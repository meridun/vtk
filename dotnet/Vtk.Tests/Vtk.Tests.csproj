<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vtk.Core\Vtk.Core.csproj" />
    <ProjectReference Include="..\Vtk.Cli\Vtk.Cli.csproj" />
    <!-- Fake external tools for the end-to-end smoke suite. The reference
         copies vtk-faketool.dll (+ runtimeconfig) into the test output dir;
         SmokeHarness materializes per-tool .cmd shims around it at runtime. -->
    <ProjectReference Include="..\Vtk.FakeTool\Vtk.FakeTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Filter\testdata\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
